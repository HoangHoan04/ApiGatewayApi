{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "GatewaySettings": {
    "GatewayName": "ERP Enterprise API Gateway",
    "Version": "1.0.0",
    "Environment": "Development"
  },
  "JwtSettings": {
    "Authority": "http://localhost:5000",
    "Issuer": "https://auth.company.com",
    "Audience": "erp-ecosystem",
    "JwksUrl": "http://localhost:5000/.well-known/jwks.json"
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:4201",
      "http://localhost:4202",
      "http://localhost:4203",
      "http://localhost:4300",
      "http://localhost:4400",
      "http://localhost:4500",
      "http://localhost:4600",
      "http://localhost:5000",
      "http://localhost:5104",
      "http://localhost:5036",
      "http://localhost:5014",
      "http://localhost:5173",
      "http://localhost:8000",
      "http://localhost:3000"
    ]
  },
  "DownstreamServices": {
    "Auth": {
      "Name": "Central Auth Service",
      "BaseUrl": "http://localhost:5000",
      "HealthEndpoint": "http://localhost:5000/.well-known/jwks.json",
      "Description": "Dịch vụ xác thực tập trung, Quản lý tài khoản & Cấp phát JWT SSO",
      "Icon": "key"
    },
    "Hrm": {
      "Name": "HRM Microservice",
      "BaseUrl": "http://localhost:5036",
      "HealthEndpoint": "http://localhost:5036/swagger/index.html",
      "Description": "Hệ thống Quản trị Nhân sự, Chấm công, Tính lương & Tuyển dụng",
      "Icon": "team"
    },
    "IntegrationHub": {
      "Name": "Integration & Sync Hub",
      "BaseUrl": "http://localhost:5104",
      "HealthEndpoint": "http://localhost:5104/swagger/v1/swagger.json",
      "Description": "Cổng tích hợp đối tác Zalo OA, VNPay, MoMo, VietQR, Telegram, Webhooks",
      "Icon": "api"
    },
    "AiGateway": {
      "Name": "AI Gateway Service",
      "BaseUrl": "http://localhost:5005",
      "HealthEndpoint": "http://localhost:5005/health",
      "Description": "Cổng điều phối AI, LLM Chatbot, OCR hóa đơn & Dự báo thông minh",
      "Icon": "robot"
    },
    "Wms": {
      "Name": "WMS Warehouse Service",
      "BaseUrl": "http://localhost:5014",
      "HealthEndpoint": "http://localhost:5014/swagger/index.html",
      "Description": "Hệ thống Quản lý Kho bãi, Xuất nhập tồn & Mã vạch",
      "Icon": "inbox"
    },
    "Tms": {
      "Name": "TMS Transportation Service",
      "BaseUrl": "http://localhost:5003",
      "HealthEndpoint": "http://localhost:5003/health",
      "Description": "Hệ thống Quản lý Vận tải, Điều phối chuyến & Giao hàng",
      "Icon": "car"
    },
    "Notification": {
      "Name": "SignalR Notification Hub",
      "BaseUrl": "http://localhost:5104",
      "HealthEndpoint": "http://localhost:5104/hubs/notifications/negotiate?negotiateVersion=1",
      "Description": "Dịch vụ thông báo thời gian thực qua SignalR Hub",
      "Icon": "bell"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth-api-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/auth/{**catch-all}" }
        ]
      },
      "auth-admin-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/admin/{**catch-all}"
        }
      },
      "auth-direct-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "auth-notification-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/notification/{**catch-all}"
        }
      },
      "auth-upload-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/upload/{**catch-all}"
        }
      },
      "auth-adminis-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/administrative/{**catch-all}"
        }
      },
      "auth-apps-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/apps/{**catch-all}"
        }
      },
      "auth-sessions-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/sessions/{**catch-all}"
        }
      },
      "auth-wellknown-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/.well-known/{**catch-all}"
        }
      },
      "hrm-route": {
        "ClusterId": "hrm-cluster",
        "Match": {
          "Path": "/api/v1/hrm/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/{**catch-all}" }
        ]
      },
      "hrm-direct-route": {
        "ClusterId": "hrm-cluster",
        "Match": {
          "Path": "/api/hrm/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v1/{**catch-all}" }
        ]
      },
      "sync-route": {
        "ClusterId": "integration-hub-cluster",
        "Match": {
          "Path": "/api/v1/sync/{**catch-all}"
        }
      },
      "adapters-route": {
        "ClusterId": "integration-hub-cluster",
        "Match": {
          "Path": "/api/v1/adapters/{**catch-all}"
        }
      },
      "mappings-route": {
        "ClusterId": "integration-hub-cluster",
        "Match": {
          "Path": "/api/v1/mappings/{**catch-all}"
        }
      },
      "credentials-route": {
        "ClusterId": "integration-hub-cluster",
        "Match": {
          "Path": "/api/v1/credentials/{**catch-all}"
        }
      },
      "logs-route": {
        "ClusterId": "integration-hub-cluster",
        "Match": {
          "Path": "/api/v1/logs/{**catch-all}"
        }
      },
      "webhooks-route": {
        "ClusterId": "integration-hub-cluster",
        "Match": {
          "Path": "/api/v1/webhooks/{**catch-all}"
        }
      },
      "hub-dashboard-route": {
        "ClusterId": "integration-hub-cluster",
        "Match": {
          "Path": "/api/v1/dashboard/{**catch-all}"
        }
      },
      "notifications-hub-route": {
        "ClusterId": "notifications-hub-cluster",
        "Match": {
          "Path": "/hubs/notifications/{**catch-all}"
        }
      },
      "ai-route": {
        "ClusterId": "ai-gateway-cluster",
        "Match": {
          "Path": "/api/v1/ai/{**catch-all}"
        }
      },
      "wms-route": {
        "ClusterId": "wms-cluster",
        "Match": {
          "Path": "/api/v1/wms/{**catch-all}"
        }
      },
      "tms-route": {
        "ClusterId": "tms-cluster",
        "Match": {
          "Path": "/api/v1/tms/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-primary": {
            "Address": "http://localhost:5000"
          }
        }
      },
      "hrm-cluster": {
        "Destinations": {
          "hrm-primary": {
            "Address": "http://localhost:5036"
          }
        }
      },
      "integration-hub-cluster": {
        "Destinations": {
          "hub-primary": {
            "Address": "http://localhost:5104"
          }
        }
      },
      "notifications-hub-cluster": {
        "Destinations": {
          "notif-primary": {
            "Address": "http://localhost:5104"
          }
        }
      },
      "ai-gateway-cluster": {
        "Destinations": {
          "ai-primary": {
            "Address": "http://localhost:5005"
          }
        }
      },
      "wms-cluster": {
        "Destinations": {
          "wms-primary": {
            "Address": "http://localhost:5014"
          }
        }
      },
      "tms-cluster": {
        "Destinations": {
          "tms-primary": {
            "Address": "http://localhost:5003"
          }
        }
      }
    }
  }
}
